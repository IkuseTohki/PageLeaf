<UserControl x:Class="PageLeaf.Views.Controls.CssNumericEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             d:DesignHeight="30"
             d:DesignWidth="200"
             mc:Ignorable="d">

    <Border Width="120"
            Height="28"
            HorizontalAlignment="Left"
            Background="{DynamicResource SurfaceBaseBrush}"
            BorderBrush="{DynamicResource OutlineBaseBrush}"
            BorderThickness="1"
            CornerRadius="4"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 数値入力エリア -->
            <Grid Grid.Column="0">
                <!-- スピナーありの場合：シンプルなTextBox -->
                <TextBox Padding="3,0"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="ValueTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Text="{Binding ElementName=Root, Path=InternalValue, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ElementName=Root, Path=ShowSpinner, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- スピナーなしの場合：候補リスト付きComboBox -->
                <ComboBox AutomationProperties.AutomationId="ValueComboBox"
                          IsEditable="True"
                          ItemsSource="{Binding ElementName=Root, Path=AvailableValues}"
                          Style="{DynamicResource IntegratedComboBoxStyle}"
                          Text="{Binding ElementName=Root, Path=InternalValue, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding ElementName=Root, Path=ShowSpinner, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
            </Grid>

            <!-- スピンボタン (マウスオーバー時のみ表示) -->
            <StackPanel Grid.Column="1"
                        Margin="2,0"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=Root, Path=IsMouseOver}" Value="True" />
                                    <Condition Binding="{Binding ElementName=Root, Path=ShowSpinner}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Width="16"
                        Height="12"
                        AutomationProperties.AutomationId="UpButton"
                        Click="UpButton_Click"
                        Style="{StaticResource IconButtonStyle}">
                    <Path Width="6"
                          Height="6"
                          Data="{StaticResource ArrowUpIconGeometry}"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform" />
                </Button>
                <Button Width="16"
                        Height="12"
                        AutomationProperties.AutomationId="DownButton"
                        Click="DownButton_Click"
                        Style="{StaticResource IconButtonStyle}">
                    <Path Width="6"
                          Height="6"
                          Data="{StaticResource ArrowDownIconGeometry}"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>

            <!-- セパレーター -->
            <Rectangle Grid.Column="2"
                       Width="1"
                       Margin="0,4"
                       Fill="{DynamicResource OutlineBaseBrush}" />

            <!-- 単位表示エリア -->
            <Grid Grid.Column="3" Width="45">
                <!-- 通常時：選択可能なComboBox -->
                <ComboBox HorizontalContentAlignment="Center"
                          IsEditable="True"
                          ItemsSource="{Binding ElementName=Root, Path=AllUnits}"
                          Style="{DynamicResource IntegratedCenterComboBoxStyle}"
                          Text="{Binding ElementName=Root, Path=InternalUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding ElementName=Root, Path=IsUnitFixed, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                <!-- 固定時：編集不可のTextBlock -->
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding ElementName=Root, Path=FixedUnit}"
                           Visibility="{Binding ElementName=Root, Path=IsUnitFixed, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>